[
 {
  "level": 2,
  "text": "خلاصه مدیریتی",
  "id": "s1"
 },
 {
  "level": 1,
  "text": "فصل اول ـ مبانی، دامنه و معماری",
  "id": "s2"
 },
 {
  "level": 2,
  "text": "۱-۱ هدف و دامنه",
  "id": "s3"
 },
 {
  "level": 2,
  "text": "۱-۲ اصول حاکم بر طراحی",
  "id": "s4"
 },
 {
  "level": 2,
  "text": "۱-۳ معماری ابزار یکپارچه",
  "id": "s5"
 },
 {
  "level": 1,
  "text": "فصل دوم ـ طراحی بالا به پایین ابزار",
  "id": "s6"
 },
 {
  "level": 2,
  "text": "۲-۱ استخراج نیازهای سنجش",
  "id": "s7"
 },
 {
  "level": 2,
  "text": "۲-۲ شناسنامه سنجش شاخص",
  "id": "s8"
 },
 {
  "level": 2,
  "text": "۲-۳ سنجش ترکیبی کمّی–کیفی",
  "id": "s9"
 },
 {
  "level": 2,
  "text": "۲-۴ منطق پویای ابزار",
  "id": "s10"
 },
 {
  "level": 1,
  "text": "فصل سوم ـ بررسی پایین به بالا و نگاشت داده‌های موجود",
  "id": "s11"
 },
 {
  "level": 2,
  "text": "۳-۱ فهرست دارایی‌های اطلاعاتی موجود",
  "id": "s12"
 },
 {
  "level": 2,
  "text": "۳-۲ ماتریس انطباق",
  "id": "s13"
 },
 {
  "level": 2,
  "text": "۳-۳ قواعد تبدیل و مدیریت شکاف‌ها",
  "id": "s14"
 },
 {
  "level": 1,
  "text": "فصل چهارم ـ اعتبارسنجی، اجرای آزمایشی و مهاجرت مرحله‌ای",
  "id": "s15"
 },
 {
  "level": 2,
  "text": "۴-۱ اعتبارسنجی چارچوب سنجش",
  "id": "s16"
 },
 {
  "level": 2,
  "text": "۴-۲ اجرای آزمایشی",
  "id": "s17"
 },
 {
  "level": 2,
  "text": "۴-۳ مراحل پنج‌گانه مهاجرت",
  "id": "s18"
 },
 {
  "level": 2,
  "text": "۴-۴ معیارهای پذیرش فنی و مدیریت نسخه",
  "id": "s19"
 },
 {
  "level": 1,
  "text": "پیوست ـ شناسنامه وب‌سرویس‌ها و نگاشت داده",
  "id": "s20"
 },
 {
  "level": 2,
  "text": "الف-۱ — ثبت احوال — هویت و ترکیب خانوار",
  "id": "s21"
 },
 {
  "level": 2,
  "text": "الف-۲ — پست — نشانی و موقعیت جغرافیایی",
  "id": "s22"
 },
 {
  "level": 2,
  "text": "الف-۳ — شاپرک و بانک‌ها — راستی‌آزمایی معیشت",
  "id": "s23"
 },
 {
  "level": 2,
  "text": "الف-۴ — بیمه — پوشش پایه درمانی",
  "id": "s24"
 },
 {
  "level": 2,
  "text": "الف-۵ — اموال و املاک — وضعیت مالکیت",
  "id": "s25"
 },
 {
  "level": 2,
  "text": "الف-۶ — آموزش‌وپرورش — وضعیت تحصیل",
  "id": "s26"
 },
 {
  "level": 2,
  "text": "الف-۷ — علوم و دانشگاه آزاد — مدارک دانشگاهی",
  "id": "s27"
 },
 {
  "level": 2,
  "text": "الف-۸ — بانک سامانه — سابقه پرونده و خدمات حمایتی",
  "id": "s28"
 },
 {
  "level": 2,
  "text": "الف-۹ — تقدم پنج‌سطحی منابع داده",
  "id": "s29"
 }
]